{
  "name": "backend",
  "version": "1.0.0",
  "description": "",
  "main": "server.js",
  "type": "module",
  "scripts": {
    "predev": "node -e \"try{const {execSync}=require('child_process');if(process.platform==='win32'){const o=execSync('netstat -ano | findstr :5000').toString();const lines=o.split('\\n').filter(l=>l.includes(':5000')&&l.includes('LISTENING'));lines.forEach(l=>{const pid=l.trim().split(/\\s+/).pop();if(pid&&pid!=='0'&&pid!=process.pid)try{execSync('taskkill /F /PID '+pid)}catch(e){}})}else{try{execSync('fuser -k 5000/tcp')}catch(e){}}}catch(e){}\"",
    "dev": "nodemon server.js",
    "start": "node server.js"
  },
  "dependencies": {
    "axios": "^1.20.0",
    "bcryptjs": "^2.4.3",
    "cloudinary": "^2.11.0",
    "compression": "^1.8.1",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "express-async-handler": "^1.2.0",
    "express-mongo-sanitize": "^2.2.0",
    "express-rate-limit": "^7.5.1",
    "express-validator": "^7.0.1",
    "helmet": "^7.1.0",
    "hpp": "^0.2.3",
    "jsonwebtoken": "^9.0.2",
    "mongodb": "^7.1.0",
    "mongoose": "^8.0.3",
    "morgan": "^1.10.0",
    "multer": "^1.4.5-lts.1",
    "multer-storage-cloudinary": "^2.2.1",
    "node-cron": "^4.6.0",
    "nodemailer": "^10.0.1",
    "slugify": "^1.6.6",
    "stripe": "^14.9.0",
    "winston": "^3.11.0",
    "xss-clean": "^0.1.4"
  },
  "devDependencies": {
    "nodemon": "^3.0.2"
  }
}
